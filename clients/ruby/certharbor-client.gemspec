# frozen_string_literal: true

# Hand-maintained packaging file. Generated sources (lib/**/*, docs/, the
# generator's own spec/) are produced by `rake generate` from the committed
# ../../backend/openapi/openapi.json and are gitignored -- see
# .openapi-generator-ignore and docs/plans/frontend-backend-split.md D4/D8,
# whose versioning and "commit the spec, not the server" pattern this mirrors
# for Ruby.

version_script = File.expand_path('../../scripts/client-version.sh', __dir__)
VERSION_STRING = File.exist?(version_script) ? `#{version_script}`.strip : '0.0.0-dev'

Gem::Specification.new do |spec|
  spec.name          = 'certharbor-client'
  spec.version       = VERSION_STRING
  spec.authors       = ['Kantharos AI']
  spec.summary       = "Typed Ruby client for the certharbor API"
  spec.description   = 'Ruby client generated by openapi-generator from backend/openapi/openapi.json. ' \
                        'Regenerate with `rake generate`; never hand-edit lib/.'
  spec.homepage      = 'https://github.com/kantharos-net/certharbor'
  # Nonstandard rather than a value from spdx.org/licenses: see ../../LICENSE
  # at the repository root (same arrangement as clients/ts/package.json,
  # "license": "SEE LICENSE IN ../../LICENSE").
  spec.license       = 'Nonstandard'
  spec.metadata      = {
    'source_code_uri' => 'https://github.com/kantharos-net/certharbor/tree/main/clients/ruby',
    'license_uri' => 'https://github.com/kantharos-net/certharbor/blob/main/LICENSE',
    'rubygems_mfa_required' => 'true'
  }

  spec.required_ruby_version = '>= 3.1'

  spec.files = Dir.glob('lib/**/*.rb') + %w[README.md certharbor-client.gemspec]
  spec.require_paths = ['lib']

  spec.add_runtime_dependency 'typhoeus', '~> 1.4', '>= 1.4.0'

  spec.add_development_dependency 'rake', '~> 13.0'
  spec.add_development_dependency 'rspec', '~> 3.6', '>= 3.6.0'
  spec.add_development_dependency 'webrick', '~> 1.8'
end
