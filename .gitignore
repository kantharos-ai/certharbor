# Secrets
.env
.env.*
!.env.example
*.env.local
secrets/
node_modules/
package-lock.json
package.json
# The e2e harness, the generated client and the SPA are each their
# own Node project and their manifests are tracked; the two patterns above
# have no slash, so they would otherwise match at any depth.
!test/e2e/package.json
!test/e2e/package-lock.json
!clients/ts/package.json
!clients/ts/package-lock.json
!frontend/package.json
!frontend/package-lock.json

# Generated client sources/build output, only the spec they're generated
# from is committed (plans/frontend-backend-split.md, Phase 0 step 8).
clients/ts/src/
clients/ts/dist/

# Ruby client: openapi-generator output and build artefacts. Only the
# hand-written packaging files (certharbor-client.gemspec, Gemfile, Rakefile,
# README.md, .rspec, .openapi-generator-ignore, spec/smoke_spec.rb,
# scripts/fix_cookie_auth.rb) are committed; see clients/ruby/README.md.
clients/ruby/lib/
clients/ruby/docs/
clients/ruby/spec/api/
clients/ruby/spec/models/
clients/ruby/spec/spec_helper.rb
clients/ruby/.openapi-generator/
clients/ruby/.gitignore
clients/ruby/.gitlab-ci.yml
clients/ruby/.cache/
clients/ruby/*.gem
clients/ruby/Gemfile.lock

# Generated ACME-server material for the Let's Encrypt leg (make e2e-le-certs)
test/e2e/fixtures/pebble/certs/

# Playwright output: reports, traces, junit, the cumulative certharbor log
test/e2e/artifacts/

# Go binaries
backend/certharbor
backend/*.exe

# Coverage profiles (unit + merged integration)
coverage.out
*.coverprofile
integration.out
merged.out

# Data files
*.db
*.sqlite
*.sql.gz
backups/

# SSL certificates (auto-generated)
backend/ssl/
ssl/

# Docker
.docker/

# Go build cache
backend/vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Backup directories from update scripts
.backup-*/

# SPA build output
frontend/dist/
*.tsbuildinfo
